# Required for Kaggle execution. Generate a token at https://www.kaggle.com/settings/api
KAGGLE_USERNAME=your_kaggle_username
# Preferred current token (starts with KGAT_):
KAGGLE_API_TOKEN=your_token
# Or use the legacy key instead of KAGGLE_API_TOKEN:
# KAGGLE_KEY=your_legacy_key

# Required by the gated SD 3.5 model. It is embedded only into the private Kaggle
# kernel request because API-pushed kernels cannot reliably access Kaggle Secrets.
# Use a fine-grained read token and keep the generated Kaggle kernel private.
HF_TOKEN=your_huggingface_read_token
